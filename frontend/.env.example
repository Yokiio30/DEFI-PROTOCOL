# DeFi Protocol Frontend — Environment Configuration
#
# Copy this file to .env and fill in deployed contract addresses:
#   cp .env.example .env
#
# Addresses are obtained after running the deployment script:
#   cd ../contracts && forge script script/Deploy.s.sol --broadcast

# Contract addresses on Sepolia testnet
VITE_LENDING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
VITE_MINING_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNANCE_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOV_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
